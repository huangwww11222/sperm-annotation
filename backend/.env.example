BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
SAM3_MODEL_ID=
SAM3_DEVICE=cuda
SAM3_DTYPE=bfloat16
SAM3_TRACK_FRAMES=5
ANOMALY_REVIEW_LOOKBACK_FRAMES=5
# 左右边缘内多少像素视为对象正在正常离场；仅豁免缩小/裁切类异常
ANOMALY_SIDE_EXIT_MARGIN_PX=10
JWT_SECRET=dev-secret-change-me
# 留空时使用 backend/storage；可设置为数据盘或共享盘绝对路径
APP_STORAGE_DIR=
# SQLite 文件路径；Docker 部署建议设为 /data/database/app.db
APP_DB_FILE=
