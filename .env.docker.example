# 部署脚本自动生成 .env 和随机密钥；手动配置时复制本文件并填写密钥。
# 默认 GPU + AI: compose.yaml,compose.gpu.yaml；仅人工 CPU: compose.yaml
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=compose.yaml,compose.gpu.yaml
WEB_PORT=8080
WEB_BIND_ADDRESS=0.0.0.0
JWT_SECRET=

# 相对路径按项目目录解析。Windows 可改为 D:/sperm-annotation-data。
APP_DATA_ROOT=./runtime
# 仅 GPU 模式需要；必须是包含配置、权重、处理器文件的完整模型目录。
SAM3_MODEL_HOST_PATH=./models/sam3
SAM3_DTYPE=bfloat16
SAM3_TRACK_FRAMES=120
ANOMALY_REVIEW_LOOKBACK_FRAMES=5
ANOMALY_SIDE_EXIT_MARGIN_PX=10
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu132

# 源码构建时留空。已发布镜像时填写同一版本的完整镜像名。
# BACKEND_IMAGE=ghcr.io/huangwww11222/sperm-annotation-backend:vX.Y.Z-gpu
# FRONTEND_IMAGE=ghcr.io/huangwww11222/sperm-annotation-frontend:vX.Y.Z
