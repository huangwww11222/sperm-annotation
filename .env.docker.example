# 对外访问端口，例如 http://服务器IP:8080
WEB_PORT=8080

# 必须修改并长期保存；修改后已有登录令牌会失效
JWT_SECRET=replace-with-at-least-32-random-bytes

# 宿主机持久化数据根目录。Windows 建议使用正斜杠和绝对路径。
APP_DATA_ROOT=D:/sperm-annotation-data

# 指向包含 SAM3 配置、权重等文件的模型快照目录。
SAM3_MODEL_HOST_PATH=D:/sperm-models/sam3

SAM3_DEVICE=cuda
SAM3_DTYPE=bfloat16
SAM3_TRACK_FRAMES=120
ANOMALY_REVIEW_LOOKBACK_FRAMES=5
ANOMALY_SIDE_EXIT_MARGIN_PX=10

# Docker 构建时安装项目锁定的 CUDA PyTorch wheel。
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu132

# 构建到本机时可保留默认值；推送镜像仓库时改为完整仓库名称。
BACKEND_IMAGE=rare-sperm-annotation-backend:local
FRONTEND_IMAGE=rare-sperm-annotation-frontend:local
